{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3100",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/services",
        "http://localhost:3100/services/ai-agents"
      ],
      "numberOfRuns": 5,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 412, "height": 823, "deviceScaleFactor": 1.75, "disabled": false },
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility", "seo", "best-practices"],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],

            "largest-contentful-paint": ["error", { "maxNumericValue": 2800, "aggregationMethod": "median" }],
            "first-contentful-paint": ["error", { "maxNumericValue": 1400, "aggregationMethod": "median" }],
            "total-blocking-time": ["error", { "maxNumericValue": 220, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02, "aggregationMethod": "median" }],
            "server-response-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median" }],
            "mainthread-work-breakdown": ["error", { "maxNumericValue": 3000, "aggregationMethod": "median" }],

            "resource-summary:script:size": ["error", { "maxNumericValue": 190000, "aggregationMethod": "median" }],
            "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 40000, "aggregationMethod": "median" }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 0, "aggregationMethod": "median" }],
            "resource-summary:image:size": ["error", { "maxNumericValue": 300000, "aggregationMethod": "median" }],
            "resource-summary:third-party:size": ["error", { "maxNumericValue": 0, "aggregationMethod": "median" }],
            "resource-summary:total:count": ["error", { "maxNumericValue": 30, "aggregationMethod": "median" }],
            "resource-summary:third-party:count": ["error", { "maxNumericValue": 0, "aggregationMethod": "median" }],
            "resource-summary:font:count": ["error", { "maxNumericValue": 0, "aggregationMethod": "median" }],

            "uses-text-compression": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
            "render-blocking-resources": ["warn", { "maxLength": 1 }],
            "unused-javascript": "off",
            "uses-http2": "off",
            "is-crawlable": ["error", { "minScore": 1 }],
            "document-title": ["error", { "minScore": 1 }],
            "meta-description": ["error", { "minScore": 1 }],
            "color-contrast": ["error", { "minScore": 1 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
